// ==========================================
// APINMC ZONE — SCRIPT.JS LENGKAP
// ==========================================

let allSkins = [];
let allAddons = [];
let allGames = [];
let allInfo = {};
let currentSkinFilter = 'semua';
let currentAddonFilter = 'semua';
let currentPreviewData = {};

document.addEventListener('DOMContentLoaded', () => {
    initNavigation();
    loadAllData();
});

// ---------- NAVIGASI HALAMAN ----------
function initNavigation() {
    const navBtns = document.querySelectorAll('.nav-item');
    const pages = document.querySelectorAll('.page');
    
    navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetPage = btn.getAttribute('data-page');
            
            navBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            pages.forEach(p => p.classList.remove('active'));
            document.getElementById(targetPage + 'Page').classList.add('active');
        });
    });
}

// ---------- MUAT SEMUA DATA ----------
async function loadAllData() {
    try {
        const [skinsRes, gamesRes, infoRes] = await Promise.all([
            fetch('skins.json'),
            fetch('games.json'),
            fetch('data.json')
        ]);
        
        allSkins = await skinsRes.json();
        allGames = await gamesRes.json();
        allInfo = await infoRes.json();
        
        // Coba muat addons.json secara terpisah
        try {
            const addonsRes = await fetch('addons.json');
            allAddons = await addonsRes.json();
        } catch (e) {
            console.log('addons.json belum tersedia');
            allAddons = [];
        }
        
        renderSkins();
        renderAddons();
        renderGames();
        renderInfo();
        initFilters();
        
    } catch (err) {
        console.error('Gagal memuat data:', err);
        showErrorHint();
    }
}

function showErrorHint() {
    document.getElementById('skinList').innerHTML = 
        '<p class="empty">Cek file JSON kamu ya</p>';
}

// ---------- FILTER KATEGORI ----------
function initFilters() {
    // Filter Skin
    document.querySelectorAll('#skinPage .filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#skinPage .filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentSkinFilter = btn.getAttribute('data-filter');
            renderSkins();
        });
    });
    
    // Filter Addon
    document.querySelectorAll('#addonPage .filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#addonPage .filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentAddonFilter = btn.getAttribute('data-filter');
            renderAddons();
        });
    });
}

// ---------- TAMPILKAN SKIN ----------
function renderSkins() {
    const grid = document.getElementById('skinList');
    let data = allSkins;
    
    if (currentSkinFilter !== 'semua') {
        data = allSkins.filter(s => s.kategori === currentSkinFilter);
    }
    
    if (!data.length) {
        grid.innerHTML = '<p class="empty">Belum ada skin di kategori ini</p>';
        return;
    }
    
    grid.innerHTML = data.map(skin => `
        <div class="card">
            <img src="${skin.gambar}" alt="${skin.tag}" class="card-img" loading="lazy">
            <div class="card-body">
                <h3 class="card-title">${skin.tag}</h3>
                <div class="card-buttons">
                    <button class="btn secondary" onclick="openPreview('${skin.gambar}', '${skin.tag}', '${(skin.deskripsi || '').replace(/'/g, "\\'")}', '${skin['link-download'] || ''}')">Preview</button>
                    <a href="${skin['link-download'] || '#'}" target="_blank" class="btn primary" style="${!skin['link-download'] ? 'opacity:0.6;pointer-events:none;' : ''}">Unduh</a>
                </div>
            </div>
        </div>
    `).join('');
}

// ---------- TAMPILKAN ADDON ----------
function renderAddons() {
    const list = document.getElementById('addonList');
    let data = allAddons;
    
    if (currentAddonFilter !== 'semua') {
        data = allAddons.filter(a => a.kategori === currentAddonFilter);
    }
    
    if (!data.length) {
        list.innerHTML = '<p class="empty">Belum ada addon</p>';
        return;
    }
    
    list.innerHTML = data.map(addon => `
        <div class="addon-card">
            <img src="${addon.gambar}" alt="${addon.nama}" class="addon-img" loading="lazy">
            <div class="addon-body">
                <div>
                    <h3 class="addon-title">${addon.nama}</h3>
                    <p class="addon-desc">${addon.deskripsi || ''}</p>
                </div>
                <div class="card-buttons">
                    <button class="btn secondary" onclick="openPreview('${addon.gambar}', '${addon.nama}', '${(addon.deskripsi || '').replace(/'/g, "\\'")}', '${addon['link-download'] || ''}')">Preview</button>
                    <a href="${addon['link-download'] || '#'}" target="_blank" class="btn primary" style="${!addon['link-download'] ? 'opacity:0.6;pointer-events:none;' : ''}">Unduh</a>
                </div>
            </div>
        </div>
    `).join('');
}

// ---------- TAMPILKAN GAME ----------
function renderGames() {
    const grid = document.getElementById('gameList');
    
    if (!allGames.length) {
        grid.innerHTML = '<p class="empty">Belum ada game</p>';
        return;
    }
    
    grid.innerHTML = allGames.map(game => `
        <div class="card">
            <div class="card-body" style="aspect-ratio:4/3;display:flex;flex-direction:column;justify-content:center;background:#f1f5f9;">
                <h3 class="card-title">${game.nama}</h3>
                <p style="font-size:12px;color:#64748b;margin-bottom:10px;">${game.deskripsi || ''}</p>
                <button class="btn primary" onclick="window.open('${game.link || '#'}', '_blank')">▶ Mainkan</button>
            </div>
        </div>
    `).join('');
}

// ---------- TAMPILKAN INFO ----------
function renderInfo() {
    const container = document.getElementById('infoContent');
    
    if (!allInfo) {
        container.innerHTML = '<p class="empty">Belum ada informasi</p>';
        return;
    }
    
    let html = '';
    
    // Bagian Beranda
    if (allInfo.beranda) {
        html += `
        <div class="info-section">
            <h4>${allInfo.beranda.judul || 'Beranda'}</h4>
            <p style="font-size:14px;line-height:1.6;">${allInfo.beranda.deskripsi || ''}</p>
        </div>`;
    }
    
    // Bagian Saluran
    if (allInfo.saluran && allInfo.saluran.length) {
        html += `
        <div class="info-section">
            <h4>Saluran Kami</h4>
            ${allInfo.saluran.map(item => `
                <div class="info-item">
                    <span>${item.nama}</span>
                    <a href="${item.link}" target="_blank">Buka →</a>
                </div>
            `).join('')}
        </div>`;
    }
    
    // Bagian Dukungan
    if (allInfo.dukungan && allInfo.dukungan.length) {
        html += `
        <div class="info-section">
            <h4>Dukungan</h4>
            ${allInfo.dukungan.map(item => `
                <div class="info-item">
                    <span>${item.nama}</span>
                    <a href="${item.link}" target="_blank">Buka →</a>
                </div>
            `).join('')}
        </div>`;
    }
    
    // Bagian Tentang
    if (allInfo.tentang) {
        html += `
        <div class="info-section">
            <h4>Tentang ApinMC Zone</h4>
            <p style="font-size:14px;line-height:1.6;">${allInfo.tentang.deskripsi || ''}</p>
            ${allInfo.tentang.sosmed && allInfo.tentang.sosmed.length ? `
                <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:10px;">
                    ${allInfo.tentang.sosmed.map(item => `
                        <a href="${item.link}" target="_blank" style="padding:6px 12px;background:#f1f5f9;border-radius:6px;color:#2563eb;text-decoration:none;font-size:13px;">${item.nama}</a>
                    `).join('')}
                </div>
            ` : ''}
        </div>`;
    }
    
    container.innerHTML = html || '<p class="empty">Belum ada informasi</p>';
}

// ---------- PREVIEW MODAL ----------
function openPreview(imgSrc, title, desc, fileLink) {
    currentPreviewData = { imgSrc, title, desc, fileLink };
    const modal = document.getElementById('previewModal');
    
    document.getElementById('previewTitle').textContent = title;
    document.getElementById('previewImage').src = imgSrc;
    document.getElementById('previewDesc').textContent = desc;
    document.getElementById('previewDownload').href = fileLink || '#';
    document.getElementById('previewDownload').style.display = fileLink ? 'block' : 'none';
    
    modal.classList.add('show');
}

function closePreview() {
    document.getElementById('previewModal').classList.remove('show');
}

// Tutup modal klik luar
document.getElementById('previewModal').addEventListener('click', e => {
    if (e.target.id === 'previewModal') closePreview();
});

// ---------- SALIN LINK & SHARE WA ----------
function copyLink() {
    const link = window.location.href;
    navigator.clipboard.writeText(link).then(() => {
        alert('Link disalin! ✅');
    }).catch(() => {
        alert('Gagal menyalin link');
    });
}

function shareWA() {
    const text = encodeURIComponent((currentPreviewData.title || 'ApinMC Zone') + '\n' + window.location.href);
    window.open(`https://wa.me/?text=${text}`, '_blank');
}
